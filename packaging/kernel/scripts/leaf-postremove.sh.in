#!/bin/sh
set -eu

kernel_release='@KERNEL_RELEASE@'

# Never unload the module here. A mounted filesystem may still be using it,
# and upgrades must not disturb the module running in the current kernel.
if command -v depmod >/dev/null 2>&1; then
    depmod -a "$kernel_release" || {
        printf 'zerofs: warning: depmod failed for %s after removal\n' \
            "$kernel_release" >&2
    }
else
    printf 'zerofs: warning: depmod is unavailable after removal\n' >&2
fi

exit 0
