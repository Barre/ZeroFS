#!/bin/sh
set -eu

module=zerofs
version='@DKMS_VERSION@'

if ! command -v dkms >/dev/null 2>&1; then
    printf 'zerofs: dkms is required to build the kernel module\n' >&2
    exit 1
fi

# Maintainer scripts may be retried after an interrupted transaction. Reuse
# same-version state only when DKMS still records this package's source tree.
source_tree="/usr/src/$module-$version"
state_directory="/var/lib/dkms/$module/$version"
source_link="/var/lib/dkms/$module/$version/source"
expected_source=$(realpath -e "$source_tree") || {
    printf 'zerofs: packaged DKMS source tree is missing: %s\n' \
        "$source_tree" >&2
    exit 1
}
if [ -e "$state_directory" ] || [ -L "$state_directory" ]; then
    if [ ! -d "$state_directory" ] || [ -L "$state_directory" ]; then
        printf 'zerofs: unsafe DKMS state directory: %s\n' \
            "$state_directory" >&2
        exit 1
    fi
    linked_source=$(realpath -e "$source_link" 2>/dev/null || true)
    if [ "$linked_source" != "$expected_source" ]; then
        printf 'zerofs: stale DKMS registration for %s/%s; remove it before retrying\n' \
            "$module" "$version" >&2
        exit 1
    fi
else
    dkms add -m "$module" -v "$version"
fi

explicit_kernel=false
running_kernel=
newest_kernel=
if [ -n "${ZEROFS_DKMS_KERNEL:-}" ]; then
    explicit_kernel=true
    set -- "$ZEROFS_DKMS_KERNEL"
else
    set --
    running_kernel=$(uname -r)
    if [ -d "/lib/modules/$running_kernel/build" ]; then
        set -- "$@" "$running_kernel"
    fi
    newest_kernel=$(
        for kernel_directory in /lib/modules/*; do
            [ -d "$kernel_directory/build" ] || continue
            printf '%s\n' "${kernel_directory##*/}"
        done | sort -V | tail -n 1
    )
    if [ -n "$newest_kernel" ] && [ "$newest_kernel" != "$running_kernel" ]; then
        set -- "$@" "$newest_kernel"
    fi
fi
[ "$#" -gt 0 ] || {
    printf '%s\n' \
        'zerofs: warning: no installed kernel has build headers; DKMS will build when headers become available' >&2
    exit 0
}
for kernel do
    case $kernel in
        '' | *[!A-Za-z0-9._+~:-]*)
            printf 'zerofs: unsafe DKMS kernel release: %s\n' "$kernel" >&2
            exit 1
            ;;
    esac
    status=$(dkms status \
        -m "$module" -v "$version" -k "$kernel" 2>/dev/null || true)
    case $status in
        *': installed'*) continue ;;
        *': built'*) ;;
        *)
            source_unavailable_marker="$state_directory/build/dkms-kernel-source/$kernel.source-unavailable"
            if [ -e "$source_unavailable_marker" ] ||
                [ -L "$source_unavailable_marker" ]; then
                if [ ! -f "$source_unavailable_marker" ] ||
                    [ -L "$source_unavailable_marker" ]; then
                    printf 'zerofs: unsafe source-unavailable marker: %s\n' \
                        "$source_unavailable_marker" >&2
                    exit 1
                fi
                rm -f -- "$source_unavailable_marker"
            fi
            build_result=0
            dkms build -m "$module" -v "$version" -k "$kernel" ||
                build_result=$?
            if [ "$build_result" -ne 0 ]; then
                # DKMS returns 77 when BUILD_EXCLUSIVE_KERNEL_MIN rejects an
                # unsupported kernel. Skip it during ordinary package setup so
                # an old running kernel cannot prevent a supported installed
                # kernel from being built. Explicit CI requests stay strict.
                if [ "$explicit_kernel" = false ] &&
                    [ "$build_result" -eq 77 ]; then
                    printf '%s\n' \
                        "zerofs: warning: skipping kernel $kernel because ZeroFS requires Linux 6.18 or newer" >&2
                    continue
                fi
                # Portable package metadata cannot depend on an exact,
                # kernel-release-specific Rust metadata or source package.
                # Leave automatic installs registered until that distribution
                # input becomes available. Explicit CI builds remain strict.
                if [ "$explicit_kernel" = false ] &&
                    [ -f "$source_unavailable_marker" ] &&
                    [ ! -L "$source_unavailable_marker" ] &&
                    [ "$(cat "$source_unavailable_marker")" = "$kernel" ]; then
                    rm -f -- "$source_unavailable_marker"
                    printf '%s\n' \
                        "zerofs: warning: skipping kernel $kernel because its required distribution Rust metadata or exact source is unavailable; install it and run dkms autoinstall" >&2
                    continue
                fi
                exit "$build_result"
            fi
            ;;
    esac
    dkms install -m "$module" -v "$version" -k "$kernel"
done

exit 0
